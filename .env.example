# Copy this file to .env and fill in the keys you have. Every provider is optional:
# without a key its feature is switched off and the rest of the report still works.

# --- Copernicus -------------------------------------------------------------------
# Climate Data Store token (https://cds.climate.copernicus.eu/profile), used by the
# batch scripts that build the ERA5 cross-check and the fire-danger projection.
CDS_API_KEY=
# Early Warning Data Store token (a different account: https://ewds.climate.copernicus.eu).
EWDS_API_KEY=
# Start of the ERA5 record. Fewer years = lighter requests, less reliable trends.
ERA5_ARCHIVE_START=1979-01-01
# Serve the last saved answer if a source is unreachable (1 = yes).
OFFLINE_FALLBACK=1

# --- AI: typed decisions --------------------------------------------------------------
# Reads free-text requests, fact-checks claims and ranks advice for the household.
# "nebius" or "typesafe" forces one; empty = the first with a key, Nebius first.
AI_PROVIDER=
# Nebius Token Factory (https://tokenfactory.nebius.com/)
NEBIUS_API_KEY=
# Pinned model; leave empty for the default (Qwen/Qwen3-235B-A22B-Instruct-2507).
NEBIUS_MODEL=
# TypeSafe Jev (https://console.typesafe.ai/keys)
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0

# --- fal.ai: illustrations, narration and voice input ---------------------------------
FAL_KEY=

# --- Google Street View (Street View Static API) --------------------------------------
# Without it the home is shown from the air (PNOA in Spain, Sentinel-2 elsewhere).
GOOGLE_MAPS_API_KEY=

# --- Wildfire sources -------------------------------------------------------------------
# Deepfire API client (app.deepfire.co -> Settings -> API clients).
DEEPFIRE_CLIENT_ID=
DEEPFIRE_CLIENT_SECRET=
# NASA FIRMS MAP_KEY (https://firms.modaps.eosdis.nasa.gov/api/map_key/).
FIRMS_MAP_KEY=

# --- 15-day forecast: ecmwf-aifs (default) or ecmwf-ifs ---------------------------------
FORECAST_PROVIDER=ecmwf-aifs

# --- Devin: autonomous engineering layer ------------------------------------------------
# A service-user token and the organisation id, from Devin's settings.
DEVIN_API_KEY=
DEVIN_ORG_ID=
# The GitHub repository Devin works on (owner/name).
DEVIN_REPO=Rathero/PreviousAI

# Python
.venv/
__pycache__/
*.pyc

# Secrets
.env

# Runtime cache of every external answer (rebuilt on demand; warm it with
# backend/scripts/prewarm.py).
data/cache/

# Narrated briefings: rendered on demand from each report.
data/media/briefings/

# The demo homes' packs: report, PDF and briefing built by
# backend/scripts/demo_build.py. Rebuilt the morning of a demonstration, because a
# pack describes the alerts and the forecast of the day it was built.
data/demo/

# fal.ai full-size originals (the web clips, posters, stills and manifest ARE versioned).
data/media/illustrations/raw/
# A place's street photo (Google Street View: not stored in the repo) and fal.ai originals.
data/media/places/*/raw/

# Raw downloads of the batch pipelines (the built layers ARE versioned).
data/catalonia/raw/
data/cds/*.nc
data/cds/*.zip
data/cds/hazards/
data/cds/*.log
data/cds/jobs.json
data/cds/pending.json

# Autonomous layer runtime state (run records in data/autonomy/runs/ are kept).
data/autonomy/queue.json

# The evaluation knowledge base: rebuilt from the reports and the catalogues by
# backend/scripts/galtea_kb.py, and dated by the reports it was built from.
data/galtea/

# The evaluation platform key (never committed; see backend/scripts/galtea_eval.py).
.env.local

# What the national analysis downloaded to build itself: the cadastre's province feeds
# and building zips, and the official flood polygons per municipality. 2.6 GB for the
# thirty towns built so far, and re-downloadable by analysis_build.py. The BUILT files
# (municipalities.json.gz, ranking.json.gz, exposure/*.json.gz) are small and are kept:
# they are the ranking, and it has to be the same list for everyone.
data/analysis/raw/
